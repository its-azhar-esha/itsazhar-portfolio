# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used only by scripts/backup-to-branch.mjs and scripts/restore-backup.mjs
# (GitHub Actions). Same value as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Supabase DB (Supabase CLI migrations only — supabase db push / query / repair)
SUPABASE_DB_PASSWORD=your-db-password

# Vercel (API deployment management — CLI/deploy only)
VERCEL_TOKEN=
# Optional: Vercel project id (defaults to the committed project id for the
# dashboard deploy-card).
VERCEL_PROJECT_ID=

# Keep-alive/backup cron auth (Vercel cron sends x-vercel-cron, so these are
# optional; used to authorize GitHub Actions fallback writes).
HEALTH_CRON_SECRET=
BACKUP_CRON_SECRET=

# Optional: explicit AES-256-GCM key for the Integration Center encrypted
# secrets. When unset, a stable key is derived from SUPABASE_SERVICE_ROLE_KEY
# + NEXT_PUBLIC_SUPABASE_URL (works, but rotation makes stored secrets
# unreadable — set this to a stable random value for production).
SECRET_ENCRYPTION_KEY=

# Analytics / AI (optional — leave empty to disable)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Notifications — Telegram bot token (optional; fallback when no token is
# stored encrypted in the admin panel).
TELEGRAM_BOT_TOKEN=

# Optional: custom domain override (set only when serving from a custom domain)
NEXT_PUBLIC_SITE_URL=https://your-custom-domain.com
